tipos <- data.frame(
id = 1:17,
tipo = c(
"normal", "fighting", "flying", "poison",
"ground", "rock", "bug", "ghost", "steel",
"fire", "water", "grass", "electric",
"psychic", "ice", "dragon", "dark"
)
)
carpeta <- "tipos"
base <- paste0(
"https://raw.githubusercontent.com/PokeAPI/sprites/master/",
"sprites/types/generation-v/black-white/"
)
dir.create(carpeta, showWarnings = FALSE)
tipos$archivo <- file.path(
carpeta,
paste0(tipos$tipo, ".png")
)
# Función para comprobar si un PNG es válido
sprite_valido <- function(archivo) {
if (!file.exists(archivo)) return(FALSE)
if (file.info(archivo)$size == 0) return(FALSE)
# Comprobar cabecera PNG
con <- file(archivo, "rb")
on.exit(close(con))
cabecera <- readBin(con, "raw", n = 8)
identical(
cabecera,
as.raw(c(137, 80, 78, 71, 13, 10, 26, 10))
)
}
tipos$correcto <- vapply(
tipos$archivo,
sprite_valido,
logical(1)
)
# Identificar faltantes
faltantes <- tipos[!tipos$correcto, ]
cat("Sprites encontrados:", sum(tipos$correcto), "\n")
cat("Sprites faltantes:", nrow(faltantes), "\n")
descargar_sprite <- function(id, tipo, destino,
intentos = 3) {
url <- paste0(base, id, ".png")
for (i in seq_len(intentos)) {
temporal <- tempfile(fileext = ".png")
resultado <- tryCatch({
respuesta <- GET(
url,
write_disk(temporal, overwrite = TRUE),
timeout(20)
)
if (
status_code(respuesta) == 200 &&
sprite_valido(temporal)
) {
file.copy(temporal, destino, overwrite = TRUE)
} else {
FALSE
}
}, error = function(e) FALSE)
unlink(temporal)
if (isTRUE(resultado) && sprite_valido(destino)) {
cat("Descargado:", tipo, "\n")
return(TRUE)
}
cat(
"Error:", tipo,
"- intento", i, "de", intentos, "\n"
)
Sys.sleep(1)
}
FALSE
}
# Descargar solo los que faltan
fallidos <- c()
if (nrow(faltantes) > 0) {
for (i in seq_len(nrow(faltantes))) {
resultado <- descargar_sprite(
id = faltantes$id[i],
tipo = faltantes$tipo[i],
destino = faltantes$archivo[i]
)
if (!resultado) {
fallidos <- c(fallidos, faltantes$tipo[i])
}
}
}
tipos$correcto <- vapply(
tipos$archivo,
sprite_valido,
logical(1)
)
cat("\n========== RESULTADO FINAL ==========\n")
cat("Total de tipos:", nrow(tipos), "\n")
cat("Sprites correctos:", sum(tipos$correcto), "\n")
cat("Sprites faltantes:", sum(!tipos$correcto), "\n")
cat("\nTipos descargados correctamente:\n")
print(tipos$tipo[tipos$correcto])
cat("\nTipos que siguen fallando:\n")
print(tipos$tipo[!tipos$correcto])
# Tabla resumen
table(tipos$correcto)
