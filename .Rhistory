d# ==========================================
read.csv2("data/pokemon.csv")
sprites_dir <- "data/sprites_mini"
base <- paste0(
"https://raw.githubusercontent.com/PokeAPI/sprites/master/",
"sprites/pokemon/versions/generation-v/icons/"
)
dir.create(sprites_dir, showWarnings = FALSE, recursive = TRUE)
sprite_valido <- function(archivo) {
if (!file.exists(archivo)) return(FALSE)
if (file.info(archivo)$size == 0) return(FALSE)
con <- file(archivo, "rb")
on.exit(close(con))
cabecera <- readBin(con, "raw", n = 8)
identical(
cabecera,
as.raw(c(137, 80, 78, 71, 13, 10, 26, 10))
)
}
pokemon$id <- as.integer(pokemon$id)
archivos <- file.path(
sprites_dir,
paste0(pokemon$id, ".png")
)
correctos <- vapply(
archivos,
sprite_valido,
logical(1)
)
faltantes <- unique(pokemon$id[!correctos])
cat("Sprites existentes:", sum(correctos), "\n")
cat("Sprites faltantes:", length(faltantes), "\n")
descargar_sprite <- function(id, intentos = 3) {
destino <- file.path(
sprites_dir,
paste0(id, ".png")
)
url <- paste0(base, id, ".png")
for (i in seq_len(intentos)) {
temporal <- tempfile(fileext = ".png")
resultado <- tryCatch({
response <- GET(
url,
write_disk(temporal, overwrite = TRUE),
timeout(20)
)
if (
status_code(response) == 200 &&
sprite_valido(temporal)
) {
file.copy(
temporal,
destino,
overwrite = TRUE
)
} else {
FALSE
}
}, error = function(e) FALSE)
unlink(temporal)
if (isTRUE(resultado) && sprite_valido(destino)) {
cat("Descargado:", id, "\n")
return(TRUE)
}
cat(
"Error:", id,
"- intento", i, "de", intentos, "\n"
)
Sys.sleep(1)
}
FALSE
}
# Descargar solamente los faltantes
fallidos <- c()
for (id in faltantes) {
resultado <- descargar_sprite(id)
if (!resultado) {
fallidos <- c(fallidos, id)
}
}
